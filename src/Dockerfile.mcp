# MCP-сервер (FastMCP, streamable-http) поверх docling-serve.
# Лёгкий образ: сам docling здесь не нужен, сервер ходит в него по HTTP.
FROM python:3.12-slim

RUN pip install --no-cache-dir "mcp<2" httpx uvicorn starlette

WORKDIR /app
COPY mcp_server.py .

EXPOSE 8000
CMD ["python", "mcp_server.py"]
