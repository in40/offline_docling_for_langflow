# HTTP-прокси для обхода бага docling-serve#567 (подробности в proxy_server.py).
# Лёгкий образ: сам docling здесь не нужен, прокси ходит в него по HTTP.
FROM python:3.12-slim


RUN pip install --no-cache-dir httpx uvicorn starlette python-multipart


WORKDIR /app
COPY proxy_server.py .


EXPOSE 5002
CMD ["python", "proxy_server.py"]
